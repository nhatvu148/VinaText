# NOTE: this ignores the whole tree, and git cannot re-include a path whose
# parent directory is excluded - so anything genuinely needed under bin/x64 has
# to be added with `git add -f`. Everything currently tracked there predates this
# rule. Adding Packages/data-packages/*.json in PR #4 looked like it worked and
# silently did nothing; tools/extract_language_data.py now checks for that.
bin/x64
# Python bytecode from tools/
__pycache__/
*.pyc
build/
qtbuild/

# The packaging build tree, alongside qtbuild/.
qtbundle/
dist/
# The WebAssembly build tree. 39MB, and the .wasm alone is 18MB - exactly the
# kind of thing that gets committed once and is then in the history forever,
# which D4 forbids rewriting away.
qtwasm/
# Tool droppings: aqtinstall's log, and the browser automation's scratch dir.
aqtinstall.log
.playwright-mcp/

# macOS finder droppings.
.DS_Store
